# Workflow env vars are mapped via workflows.yaml — each workflow defines
# which env var names to read for workflow_id, compute_node_id, etc.
# To add a new workflow type, add a block to workflows.yaml and set the
# corresponding env vars here. No code changes needed.
#
# Copy this file to .env in the project root and fill in your values:
#   cp examples/.env.example .env

# --- Pennsieve credentials (required) ---
PENNSIEVE_SESSION_TOKEN=
PENNSIEVE_REFRESH_TOKEN=

# API host (switch between prod and dev)
# Prod: https://api2.pennsieve.io
# Dev:  https://api2.pennsieve.net
PENNSIEVE_API_HOST=https://api2.pennsieve.io

# Dataset ID (shared across workflows)
DATASET_ID=

# --- NIfTI-to-Zarr workflow ---
NIFTI_WORKFLOW_ID=
NIFTI_COMPUTE_NODE_ID=
NIFTI_SOURCE_NODE_ID=
NIFTI_TARGET_ZARR_NODE_ID=
NIFTI_TARGET_THUMB_NODE_ID=
NIFTI_PROCESSOR_NODE_ID=
NIFTI_THUMB_PROCESSOR_NODE_ID=
NIFTI_PROCESSOR_VERSION=v1.1.1
NIFTI_THUMB_PROCESSOR_VERSION=v1.3.1

# --- OME-TIFF-to-Zarr workflow (also used by plain TIFF) ---
TIFF_WORKFLOW_ID=
TIFF_COMPUTE_NODE_ID=
TIFF_SOURCE_NODE_ID=
TIFF_TARGET_ZARR_NODE_ID=
TIFF_TARGET_THUMB_NODE_ID=
TIFF_PROCESSOR_NODE_ID=
TIFF_THUMB_PROCESSOR_NODE_ID=
TIFF_PROCESSOR_VERSION=v1.2.4
TIFF_THUMB_PROCESSOR_VERSION=v1.3.1

# --- Timeseries-to-Zarr workflow ---
TS_WORKFLOW_ID=
TS_COMPUTE_NODE_ID=
TS_SOURCE_NODE_ID=
TS_TARGET_ZARR_NODE_ID=
TS_TARGET_THUMB_NODE_ID=
TS_PROCESSOR_NODE_ID=
TS_THUMB_PROCESSOR_NODE_ID=
TS_PROCESSOR_VERSION=v1.0.0
TS_THUMB_PROCESSOR_VERSION=v1.3.1

# Delay between triggering runs in seconds (default: 30)
DELAY_BETWEEN_RUNS=30
