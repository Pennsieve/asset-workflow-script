# Pennsieve session token (required — grab from browser, expires ~1hr)
PENNSIEVE_SESSION_TOKEN=

# Refresh token (optional — grab from browser x-refresh-token header, keeps session alive)
PENNSIEVE_REFRESH_TOKEN=

# API host (switch between prod and dev)
# Prod: https://api2.pennsieve.io
# Dev:  https://api2.pennsieve.net
PENNSIEVE_API_HOST=https://api2.pennsieve.io

# Workflow configuration (different per environment)
WORKFLOW_ID=
DATASET_ID=
ORGANIZATION_ID=
COMPUTE_NODE_ID=

# Node IDs (all differ between prod and dev workflows)
SOURCE_NODE_ID=
TARGET_ZARR_NODE_ID=
TARGET_THUMB_NODE_ID=
NIFTI_PROCESSOR_NODE_ID=
THUMB_PROCESSOR_NODE_ID=

# Delay between triggering runs in seconds (default: 30)
DELAY_BETWEEN_RUNS=30
